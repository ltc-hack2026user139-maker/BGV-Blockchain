# ── Docker Compose (only needed when running BGV in Docker) ──────────────────
FABRIC_SAMPLES_PATH=C:/Users/fabric-samples

# ── Cortex / Gemini OCR ───────────────────────────────────────────────────────
CORTEX_BASE_URL=
CORTEX_API_KEY=
GEMINI_MODEL=

# ── Hyperledger Fabric (leave FABRIC_GATEWAY_PEER blank to use local NDJSON) ──
# Set FABRIC_GATEWAY_PEER to switch to on-chain ledger in production.
FABRIC_GATEWAY_PEER=
FABRIC_MSP_ID=
FABRIC_MSP_CONFIG_PATH=
FABRIC_TLS_CERT_PATH=
FABRIC_PEER2_ADDRESS=
FABRIC_PEER2_TLS_CERT=
FABRIC_ORDERER_ADDRESS=
FABRIC_ORDERER_TLS_CERT=
FABRIC_CFG_PATH=
FABRIC_BIN_PATH=
FABRIC_CHANNEL=
FABRIC_CHAINCODE=

# ── Local ledger fallback (used when FABRIC_GATEWAY_PEER is blank) ───────────
BGV_LEDGER_PATH=bgv_ledger.ndjson
